---
import Price from './Price.astro';
import TownPicker from './TownPicker.astro';
interface Props { id?: string }
const { id = 'checker' } = Astro.props;
---
<div class="checker" data-checker>
  <TownPicker id={`${id}-input`} label="Check delivery to your area" placeholder="Search, or type your nearest town" />
  <p class="out" aria-live="polite" data-out>From <Price k="band:0" /> near Harare to <Price k="band:3" /> for the furthest towns. One charge per order.</p>
</div>
<script>
  import { currentFeed } from '../scripts/live-prices';
  import { bandFor, findTown, usd } from '../lib/pricing';
  document.querySelectorAll<HTMLElement>('[data-checker]').forEach((root) => {
    const input = root.querySelector('input')!;
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    const initial = out.innerHTML;
    const run = () => {
      const feed = currentFeed();
      const q = input.value.trim();
      if (!q) { out.innerHTML = initial; return; }
      const t = findTown(feed, q);
      if (t) {
        const b = bandFor(feed, t.km);
        out.textContent = t.km === 0
          ? `${t.place}: delivery and logistics is ${usd(b.price)} per order.`
          : `${t.place} is about ${t.km} km from Harare by road. Delivery and logistics: ${usd(b.price)} per order.`;
      } else if (q.length > 2) {
        out.textContent = `${q} isn't on our list yet. We still deliver there: send us your nearest town on WhatsApp and we'll work out the distance.`;
      }
    };
    input.addEventListener('input', run);
    addEventListener('fishtech:prices', run);
  });
</script>
<style>
  .checker { display: grid; gap: 0.5rem; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem; }
  .out { color: var(--ink); }
  .out :global([data-price]) { color: var(--teal); font-weight: 750; }
</style>
