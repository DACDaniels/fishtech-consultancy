---
import { CHANNEL } from '../lib/site';
---
<section class="channel" aria-labelledby="channel-title">
  <div class="wrap row">
    <div>
      <h2 id="channel-title">Follow FishTech on WhatsApp</h2>
      <p class="muted">News and updates from FishTech, on our WhatsApp channel.</p>
    </div>
    <a class="btn btn-line" href={CHANNEL} rel="noopener">Follow the channel</a>
  </div>
</section>
<style>
  .channel { padding-block: 3rem; border-top: 1px solid var(--line); }
  .row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.5rem; }
  h2 { font-size: var(--step-3); margin-bottom: 0.4rem; }
</style>
