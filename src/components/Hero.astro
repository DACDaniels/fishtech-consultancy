---
// Home hero. Under water, looking down into a pond:
// - caustics: the moving net of light that sunlight throws on a pond floor (WebGL shader, ours)
// - a school of fingerlings that swims as a group (boids flocking) and scatters from the pointer
// - light shafts from the surface
// - a split-flap price board fed by the live price list
// - a depth gauge that sinks as you scroll (desktop)
import WaButton from './WaButton.astro';
import { feed } from '../lib/site';
import { bandLabel, resolvePrice, sizeLabel, sortedBands, usd } from '../lib/pricing';

type Item = { label: string; key: string };
const rows: Item[][] = [
  [
    { label: '10 × 10 m pond, 250 micron', key: 'pond:10 x 10 m:250' },
    { label: '10 × 20 m pond, 300 micron', key: 'pond:10 x 20 m:300' },
    { label: '20 × 20 m pond, 300 micron', key: 'pond:20 x 20 m:300' },
    { label: '20 × 30 m pond, 400 micron', key: 'pond:20 x 30 m:400' },
  ],
  [
    { label: `Tilapia fingerlings, ${feed.fingerlings.per.toLocaleString('en-US')}`, key: 'fingerlings' },
    { label: `Bird / predator net, ${sizeLabel('10 x 10 m')}`, key: 'net:10 x 10 m' },
    { label: 'Grower feed, 25 kg bag', key: 'feed:Grower' },
    { label: 'Starter feed, 10 kg bag', key: 'feed:Starter 2' },
  ],
  [
    ...sortedBands(feed).map((b, i) => ({ label: `Delivery, ${bandLabel(b).toLowerCase()}`, key: `band:${i}` })),
    { label: 'Site visit, taken off the job', key: 'site-visit' },
  ],
];
const first = rows.map((r) => r[0]);
const W = 6; // price cells, right-aligned
const cells = (key: string) => usd(resolvePrice(feed, key) ?? 0).padStart(W, ' ').split('');
---
<section class="hero" aria-labelledby="hero-title" data-hero>
  <canvas class="caustics" data-caustics aria-hidden="true"></canvas>
  <div class="shafts" aria-hidden="true"></div>
  <canvas class="school" data-school aria-hidden="true"></canvas>
  <div class="veil" aria-hidden="true"></div>

  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="status">
        <svg class="sonar" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3" /><circle class="s1" cx="12" cy="12" r="6.5" /><circle class="s2" cx="12" cy="12" r="10" /></svg>
        Our sales line is open on WhatsApp now
      </p>
      <h1 id="hero-title" data-hero-title>Fish ponds, built properly, anywhere in Zimbabwe</h1>
      <p class="hero-lede" data-hero-in>We dig and line fish ponds, put up bird and predator nets, and supply tilapia fingerlings and feed. Get a written price on WhatsApp in minutes.</p>
      <div class="btn-row" data-first-cta data-hero-in>
        <WaButton tag="hero" message="Hi FishTech, I'd like a price for a fish pond." />
        <a class="btn btn-ghost" href="#prices">Price your pond</a>
      </div>
    </div>

    <aside class="board" aria-label="Live prices" data-board data-rows={JSON.stringify(rows)} data-hero-in>
      <header><span class="live"></span>Live prices<span class="src">from our price list</span></header>
      <ol>
        {first.map((it) => (
          <li data-row data-key={it.key}>
            <span class="label" data-label>{it.label}</span>
            <span class="flaps num" aria-hidden="true">{cells(it.key).map((c) => <span class="flap">{c === ' ' ? ' ' : c}</span>)}</span>
            <span class="visually-hidden" data-sr>{usd(resolvePrice(feed, it.key) ?? 0)}</span>
          </li>
        ))}
      </ol>
      <a href="/pond-prices" class="all">All prices</a>
    </aside>
  </div>

  <div class="gauge" aria-hidden="true" data-gauge>
    <span class="g-label">Depth <b data-depth>0.0</b> m</span>
    <div class="g-rule">{Array.from({ length: 16 }, (_, i) => <i class={i % 5 === 0 ? 'major' : ''} data-n={i % 5 === 0 ? (i / 10).toFixed(1) : undefined}></i>)}<span class="g-mark" data-gauge-mark></span></div>
  </div>

  <svg class="edge-wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,46 C220,70 380,18 620,40 C820,58 980,26 1180,36 C1300,42 1380,30 1440,26 V80 H0 Z" />
    <path class="edge-line" d="M0,46 C220,70 380,18 620,40 C820,58 980,26 1180,36 C1300,42 1380,30 1440,26" />
  </svg>
</section>

<style>
  .hero {
    position: relative; overflow: hidden; isolation: isolate;
    margin-top: calc(-1 * var(--header-h)); padding-top: var(--header-h);
    background: linear-gradient(180deg, var(--deep) 0%, var(--ink-deep) 100%);
    color: var(--white); min-height: min(100svh, 60rem); display: grid; grid-template-rows: 1fr auto;
  }
  .caustics, .school, .shafts, .veil { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .caustics { z-index: -4; opacity: 0; transition: opacity 1.6s ease-out; }
  .caustics.on { opacity: 1; }
  .shafts {
    z-index: -3; inset: -30% -10% 20% -10%; height: auto; mix-blend-mode: screen; opacity: 0.55;
    background:
      linear-gradient(104deg, transparent 18%, rgba(var(--glow-rgb), 0.07) 21%, transparent 25%),
      linear-gradient(98deg, transparent 38%, rgba(var(--glow-rgb), 0.05) 40%, transparent 46%),
      linear-gradient(108deg, transparent 58%, rgba(var(--glow-rgb), 0.08) 61%, transparent 64%),
      linear-gradient(101deg, transparent 72%, rgba(var(--glow-rgb), 0.05) 76%, transparent 81%);
    mask-image: linear-gradient(180deg, #000 0%, transparent 75%); -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 75%);
    transform-origin: 50% 0;
  }
  .school { z-index: -2; opacity: 0; transition: opacity 1.4s ease-out; }
  .school.on { opacity: 1; }
  .veil { z-index: -1; background: linear-gradient(90deg, rgba(var(--deep-rgb), 0.7) 0%, rgba(var(--deep-rgb), 0.3) 40%, transparent 65%); }

  .hero-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(2rem, 1rem + 3vw, 4rem); align-items: end; padding-block: clamp(3rem, 2rem + 5vw, 7rem) clamp(2rem, 1rem + 3vw, 4rem); }
  .hero-copy { display: grid; gap: 1.6rem; justify-items: start; }
  .status { display: inline-flex; align-items: center; gap: 0.6rem; font-size: var(--step--1); font-weight: 600; color: var(--on-deep-muted); }
  .sonar { width: 1.4rem; height: 1.4rem; fill: none; stroke: var(--green); stroke-width: 1.4; }
  .sonar circle:first-child { fill: var(--green); stroke: none; }
  h1 { color: var(--white); font-size: clamp(3rem, 1.4rem + 5.6vw, 6.5rem); font-weight: 800; font-stretch: 66%; line-height: 0.92; letter-spacing: -0.02em; max-width: 12ch; }
  .hero-lede { font-size: var(--step-1); line-height: 1.5; max-width: 30em; color: var(--on-deep-muted); }
  .hero :global(.btn-ghost) { background: rgba(255, 255, 255, 0.06); color: var(--white); box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.35); }
  .hero :global(.btn-ghost:hover) { background: rgba(255, 255, 255, 0.12); }

  .board {
    align-self: end; background: rgba(2, 12, 16, 0.55); border-radius: 18px; padding: 1.1rem 1.25rem 1rem;
    box-shadow: inset 0 0 0 1px rgba(var(--glow-rgb), 0.18), 0 40px 80px -40px rgba(0, 0, 0, 0.8); backdrop-filter: blur(10px);
  }
  .board header { display: flex; align-items: center; gap: 0.55rem; font-weight: 750; font-size: var(--step--1); color: var(--white); padding-bottom: 0.8rem; border-bottom: 1px solid rgba(var(--glow-rgb), 0.15); }
  .board .src { margin-left: auto; font-weight: 500; color: var(--on-deep-muted); }
  .live { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--green); animation: blink 2.4s ease-in-out infinite; }
  .board ol { list-style: none; margin: 0; padding: 0; }
  .board li { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 1rem; padding-block: 0.85rem; border-bottom: 1px solid rgba(var(--glow-rgb), 0.1); min-height: 3.6rem; }
  .label { color: #dcefed; font-size: var(--step--1); line-height: 1.3; }
  .flaps { display: inline-flex; gap: 2px; perspective: 400px; }
  .flap {
    display: inline-grid; place-items: center; width: 1.25rem; height: 1.8rem; border-radius: 3px; font-weight: 800; font-size: 1.15rem;
    color: var(--gold); background: linear-gradient(180deg, #0a2a45 0%, #0a2a45 49%, #04182b 51%, #04182b 100%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05); transform-origin: 50% 50%;
  }
  .all { display: inline-block; margin-top: 0.8rem; font-size: var(--step--1); font-weight: 650; color: var(--glow); text-decoration: none; }
  .all:hover { text-decoration: underline; }

  .gauge { position: absolute; right: clamp(0.75rem, 2vw, 1.75rem); top: calc(var(--header-h) + 3rem); bottom: 6rem; display: grid; grid-template-rows: auto 1fr; gap: 0.75rem; justify-items: end; font-size: 0.72rem; color: var(--on-deep-muted); }
  .g-label b { color: var(--white); font-variant-numeric: tabular-nums; }
  .g-rule { position: relative; display: flex; flex-direction: column; justify-content: space-between; width: 2.2rem; }
  .g-rule i { display: block; height: 1px; width: 0.5rem; margin-left: auto; background: rgba(var(--glow-rgb), 0.35); position: relative; }
  .g-rule i.major { width: 1rem; background: rgba(var(--glow-rgb), 0.7); }
  .g-rule i[data-n]::before { content: attr(data-n); position: absolute; right: 1.35rem; top: -0.45rem; font-style: normal; }
  .g-mark { position: absolute; right: 0; top: 0; width: 1.4rem; height: 2px; background: var(--gold); box-shadow: 0 0 10px var(--gold); }

  .edge-wave { display: block; width: 100%; height: clamp(2.5rem, 5vw, 5rem); margin-bottom: -1px; }
  .edge-wave path { fill: var(--mist); }
  .edge-wave .edge-line { fill: none; stroke: var(--green); stroke-width: 2; vector-effect: non-scaling-stroke; }

  @keyframes blink { 50% { opacity: 0.35; } }
  @media (prefers-reduced-motion: no-preference) {
    .sonar .s1, .sonar .s2 { animation: ping 2.4s ease-out infinite; transform-origin: center; transform-box: fill-box; }
    .sonar .s2 { animation-delay: 0.4s; }
    .shafts { animation: sway 14s ease-in-out infinite alternate; }
    :global(html.motion:not(.hero-ready)) [data-hero-in], :global(html.motion:not(.hero-ready)) .status, :global(html.motion:not(.hero-ready)) .gauge { opacity: 0; }
    :global(html.motion:not(.hero-ready)) [data-hero-title] { visibility: hidden; }
  }
  @keyframes ping { 0% { opacity: 1; transform: scale(0.6); } 100% { opacity: 0; transform: scale(1.3); } }
  @keyframes sway { from { transform: rotate(-2.5deg) translateX(-2%); } to { transform: rotate(2.5deg) translateX(2%); } }

  @media (max-width: 1100px) { .gauge { display: none; } }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; align-items: start; }
    .veil { background: linear-gradient(180deg, rgba(var(--deep-rgb), 0.7) 0%, rgba(var(--deep-rgb), 0.35) 60%, transparent 100%); }
    .board { width: 100%; max-width: 30rem; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { SplitText } from 'gsap/SplitText';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { currentFeed } from '../scripts/live-prices';
  import { resolvePrice, usd } from '../lib/pricing';
  import { startCaustics } from '../scripts/caustics';
  import { startSchool } from '../scripts/school';
  import { DUR, EASE, STAGGER, reduced } from '../scripts/motion';
  gsap.registerPlugin(SplitText, ScrollTrigger);

  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const root = document.documentElement;
  const still = reduced();

  // Split-flap price board: each row moves on to its next item in turn.
  const board = hero.querySelector<HTMLElement>('[data-board]')!;
  const rows = JSON.parse(board.dataset.rows || '[]') as { label: string; key: string }[][];
  const rowEls = Array.from(board.querySelectorAll<HTMLElement>('[data-row]'));
  const idx = rows.map(() => 0);
  const W = 6;
  function flip(r: number) {
    const feed = currentFeed();
    idx[r] = (idx[r] + 1) % rows[r].length;
    const item = rows[r][idx[r]];
    const el = rowEls[r];
    const price = usd(resolvePrice(feed, item.key) ?? 0);
    const chars = price.padStart(W, ' ').split('');
    const label = el.querySelector<HTMLElement>('[data-label]')!;
    const flaps = Array.from(el.querySelectorAll<HTMLElement>('.flap'));
    el.querySelector<HTMLElement>('[data-sr]')!.textContent = price;
    const tl = gsap.timeline();
    tl.to(label, { opacity: 0, y: -8, duration: DUR.quick, ease: EASE.inOut })
      .call(() => { label.textContent = item.label; })
      .fromTo(label, { y: 8 }, { opacity: 1, y: 0, duration: DUR.quick, ease: EASE.soft });
    flaps.forEach((f, i) => {
      const next = chars[i] === ' ' ? ' ' : chars[i];
      if (f.textContent === next) return;
      tl.to(f, { rotationX: -90, duration: 0.12, ease: 'power1.in' }, 0.05 + i * 0.05)
        .call(() => { f.textContent = next; }, undefined, 0.17 + i * 0.05)
        .fromTo(f, { rotationX: 90 }, { rotationX: 0, duration: 0.2, ease: 'back.out(2)' }, 0.17 + i * 0.05);
    });
  }

  function heroIn() {
    root.classList.add('hero-ready');
    if (still) return;
    const title = hero.querySelector<HTMLElement>('[data-hero-title]')!;
    const split = SplitText.create(title, { type: 'lines', mask: 'lines', linesClass: 'm-line' });
    const tl = gsap.timeline({ defaults: { ease: EASE.out } });
    tl.from(split.lines, { yPercent: 108, duration: DUR.epic, stagger: STAGGER * 1.4 })
      .from('.status', { opacity: 0, y: 12, duration: DUR.slow }, 0)
      .from(hero.querySelectorAll('.hero-copy [data-hero-in]'), { opacity: 0, y: 24, duration: DUR.slow, stagger: 0.12 }, 0.45)
      .from(board, { opacity: 0, y: 40, duration: DUR.slow }, 0.6)
      .from(board.querySelectorAll('.flap'), { rotationX: -90, opacity: 0, duration: 0.35, stagger: 0.02, ease: 'back.out(2)' }, 0.85)
      .from('.gauge', { opacity: 0, duration: DUR.slow }, 1);
    // Depth gauge sinks from 0 to 1.5 m as the hero scrolls away.
    const mark = hero.querySelector<HTMLElement>('[data-gauge-mark]');
    const depth = hero.querySelector<HTMLElement>('[data-depth]');
    const rule = hero.querySelector<HTMLElement>('.g-rule');
    if (mark && depth && rule) {
      ScrollTrigger.create({
        trigger: hero, start: 'top top', end: 'bottom top', scrub: true,
        onUpdate: (s) => { gsap.set(mark, { y: s.progress * rule.clientHeight }); depth.textContent = (s.progress * 1.5).toFixed(1); },
      });
    }
    // Board rows turn over in a steady rhythm, one row at a time.
    let r = 0;
    setInterval(() => { if (!document.hidden) { flip(r); r = (r + 1) % rows.length; } }, 2600);
  }

  // Backgrounds start straight away (behind the intro), the content after it.
  if (!still) {
    startCaustics(hero.querySelector('[data-caustics]')!, hero);
    startSchool(hero.querySelector('[data-school]')!, hero);
  }
  if (root.classList.contains('intro')) addEventListener('fishtech:intro-done', heroIn, { once: true });
  else heroIn();
  // Prices changed in the live feed: refresh what the board shows now.
  addEventListener('fishtech:prices', () => rowEls.forEach((el, i) => {
    const item = rows[i][idx[i]];
    const price = usd(resolvePrice(currentFeed(), item.key) ?? 0);
    el.querySelector<HTMLElement>('[data-sr]')!.textContent = price;
    price.padStart(W, ' ').split('').forEach((c, j) => { const f = el.querySelectorAll('.flap')[j]; if (f) f.textContent = c === ' ' ? ' ' : c; });
  }));
</script>
