---
// Home hero. No photo: a dark water scene with a dotted grid, soft glows, rain-like
// ripples on a canvas, the FishTech mark as giant line art, and an isometric line
// drawing of a lined 20 × 20 m pond that builds itself, with live-price chips.
import Price from './Price.astro';
import WaButton from './WaButton.astro';
import { feed } from '../lib/site';
import { microns, pondSizes } from '../lib/pricing';

// Isometric projection of a pond, in metres. x runs right-down, y left-down, z up.
const S = 11.2, CX = 280, CY = 70, DEPTH = 4.2; // depth exaggerated ×2.8 so the walls read
const P = (x: number, y: number, z = 0) => [CX + (x - y) * S * 0.866, CY + (x + y) * S * 0.5 - z * S];
const pt = (p: number[]) => `${p[0].toFixed(1)},${p[1].toFixed(1)}`;
const L = 20;
const rim = [P(0, 0), P(L, 0), P(L, L), P(0, L)];
const floor = [P(0, 0, -DEPTH), P(L, 0, -DEPTH), P(L, L, -DEPTH), P(0, L, -DEPTH)];
const W = 1.3; // water sits below the rim
const water = [P(0.6, 0.6, -W), P(L - 0.6, 0.6, -W), P(L - 0.6, L - 0.6, -W), P(0.6, L - 0.6, -W)];
// Plan-to-screen matrix for the water surface, used to draw ripples as true isometric circles.
const wz = P(0, 0, -W);
const m = `matrix(${(S * 0.866).toFixed(3)} ${(S * 0.5).toFixed(3)} ${(-S * 0.866).toFixed(3)} ${(S * 0.5).toFixed(3)} ${wz[0].toFixed(2)} ${wz[1].toFixed(2)})`;
const groundLines = Array.from({ length: 9 }, (_, i) => -8 + i * 4.5);
const nSizes = pondSizes(feed).length;
const nMicrons = microns(feed).length;
const nTowns = feed.towns.length;
---
<section class="hero" aria-labelledby="hero-title" data-hero>
  <canvas class="ripples" data-ripples aria-hidden="true"></canvas>
  <div class="dots" aria-hidden="true"></div>
  <div class="glow g1" aria-hidden="true"></div>
  <div class="glow g2" aria-hidden="true"></div>
  <svg class="lineart" viewBox="-10 -10 120 120" aria-hidden="true">
    <path pathLength="1" d="M 26,0 L 100,0 L 100,44 C 86,48 68,44 56,52 C 38,64 22,42 0,54 L 0,26 A 26 26 0 0 1 26,0 Z" />
    <path pathLength="1" d="M 0,60 C 22,48 38,70 56,58 C 68,50 86,54 100,50 L 100,74 A 26 26 0 0 1 74,100 L 0,100 Z" />
  </svg>

  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="kicker"><span class="pulse"></span>Answering on WhatsApp now, day and night</p>
      <h1 id="hero-title">
        <span class="line"><span>Fish ponds,</span></span>
        <span class="line"><span>built properly,</span></span>
        <span class="line"><span>anywhere in</span></span>
        <span class="line"><span class="sheen">Zimbabwe</span></span>
      </h1>
      <p class="hero-lede">We dig and line fish ponds, put up bird nets, and supply tilapia fingerlings and feed. Get a written price from our assistant in minutes.</p>
      <div class="btn-row" data-first-cta>
        <WaButton tag="hero" message="Hi FishTech, I'd like a price for a fish pond." />
        <a class="btn btn-ghost" href="#prices">Price your pond</a>
      </div>
    </div>

    <div class="stage" aria-hidden="true">
      <svg class="pond" viewBox="0 0 560 400" data-pond-art>
        <defs>
          <linearGradient id="h-water" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#2fd0c6" stop-opacity=".55" />
            <stop offset="1" stop-color="#00707c" stop-opacity=".35" />
          </linearGradient>
          <linearGradient id="h-wall" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#0d4a53" /><stop offset="1" stop-color="#062d34" />
          </linearGradient>
          <filter id="h-glow" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="3" /></filter>
          <clipPath id="h-clip"><polygon points={water.map(pt).join(' ')} /></clipPath>
        </defs>
        <g class="ground">
          {groundLines.map((t) => <line x1={P(t, -8)[0]} y1={P(t, -8)[1]} x2={P(t, 28)[0]} y2={P(t, 28)[1]} />)}
          {groundLines.map((t) => <line x1={P(-8, t)[0]} y1={P(-8, t)[1]} x2={P(28, t)[0]} y2={P(28, t)[1]} />)}
        </g>
        <polygon class="wall" points={[rim[0], rim[1], floor[1], floor[0]].map(pt).join(' ')} />
        <polygon class="wall w2" points={[rim[0], rim[3], floor[3], floor[0]].map(pt).join(' ')} />
        <polygon class="floor" points={floor.map(pt).join(' ')} />
        <g class="folds">
          {[0.2, 0.4, 0.6, 0.8].map((f) => <line x1={P(L * f, 0)[0]} y1={P(L * f, 0)[1]} x2={P(L * f, 0, -DEPTH)[0]} y2={P(L * f, 0, -DEPTH)[1]} />)}
          {[0.2, 0.4, 0.6, 0.8].map((f) => <line x1={P(0, L * f)[0]} y1={P(0, L * f)[1]} x2={P(0, L * f, -DEPTH)[0]} y2={P(0, L * f, -DEPTH)[1]} />)}
        </g>
        <polygon class="water" points={water.map(pt).join(' ')} />
        <g clip-path="url(#h-clip)"><g transform={m} data-pond-ripples></g></g>
        <polygon class="rim glowline" points={rim.map(pt).join(' ')} filter="url(#h-glow)" />
        <polygon class="rim draw" points={rim.map(pt).join(' ')} pathLength="1" />
        <polyline class="edge draw" points={[rim[1], floor[1]].map(pt).join(' ')} pathLength="1" />
        <polyline class="edge draw" points={[rim[3], floor[3]].map(pt).join(' ')} pathLength="1" />
        <polyline class="edge draw" points={[rim[0], floor[0]].map(pt).join(' ')} pathLength="1" />
        <g class="dims">
          <line x1={P(0, L + 2.4)[0]} y1={P(0, L + 2.4)[1]} x2={P(L, L + 2.4)[0]} y2={P(L, L + 2.4)[1]} />
          <text x={P(L / 2, L + 4.8)[0]} y={P(L / 2, L + 4.8)[1]} text-anchor="middle">20 m</text>
          <line x1={P(L + 2.4, 0)[0]} y1={P(L + 2.4, 0)[1]} x2={P(L + 2.4, L)[0]} y2={P(L + 2.4, L)[1]} />
          <text x={P(L + 4.4, L / 2)[0]} y={P(L + 4.4, L / 2)[1]} text-anchor="middle">20 m</text>
          <line x1={P(-1.6, 0)[0]} y1={P(-1.6, 0)[1]} x2={P(-1.6, 0, -DEPTH)[0]} y2={P(-1.6, 0, -DEPTH)[1]} />
          <text x={P(-1.6, 0, -DEPTH / 2)[0] - 10} y={P(-1.6, 0, -DEPTH / 2)[1]} text-anchor="end">1.5 m deep</text>
        </g>
      </svg>
      <div class="chip c1"><span class="dot"></span>20 × 20 m, 300 micron <strong><Price k="pond:20 x 20 m:300" /></strong></div>
      <div class="chip c2"><span class="dot"></span>HDPE liner, fitted</div>
      <div class="chip c3"><span class="dot"></span>Bird net <strong><Price k="net:20 x 20 m" /></strong></div>
      <div class="chip c4"><span class="dot"></span>Delivery across Zimbabwe</div>
    </div>
  </div>

  <div class="wrap facts" role="list">
    <div role="listitem"><strong class="num" data-count={nSizes}>{nSizes}</strong><span>standard pond sizes, other sizes on request</span></div>
    <div role="listitem"><strong class="num" data-count={nMicrons}>{nMicrons}</strong><span>liner thicknesses, from <Price k="pond-from" /></span></div>
    <div role="listitem"><strong class="num" data-count={nTowns}>{nTowns}</strong><span>towns priced for delivery, and more on request</span></div>
    <div role="listitem"><strong class="num">24/7</strong><span>WhatsApp assistant, written quotations</span></div>
  </div>
  <svg class="edge-wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,46 C220,70 380,18 620,40 C820,58 980,26 1180,36 C1300,42 1380,30 1440,26 V80 H0 Z" />
    <path class="edge-line" d="M0,46 C220,70 380,18 620,40 C820,58 980,26 1180,36 C1300,42 1380,30 1440,26" />
  </svg>
</section>

<style>
  .hero {
    --ink-deep: #031b20;
    position: relative; overflow: hidden; isolation: isolate;
    margin-top: calc(-1 * var(--header-h)); padding-top: var(--header-h);
    background: radial-gradient(120% 90% at 75% 30%, #0a4a55 0%, #05313a 38%, var(--ink-deep) 78%);
    color: var(--white); min-height: min(100svh, 62rem); display: grid; grid-template-rows: 1fr auto auto;
  }
  .ripples, .dots, .glow, .lineart { position: absolute; pointer-events: none; z-index: -1; }
  .ripples { inset: 0; width: 100%; height: 100%; opacity: 0.9; }
  .dots {
    inset: 0;
    background-image: radial-gradient(rgba(143, 203, 198, 0.22) 1px, transparent 1.4px);
    background-size: 28px 28px;
    mask-image: radial-gradient(80% 70% at 60% 40%, #000 30%, transparent 85%);
    -webkit-mask-image: radial-gradient(80% 70% at 60% 40%, #000 30%, transparent 85%);
  }
  .glow { border-radius: 50%; filter: blur(70px); }
  .g1 { width: 38rem; height: 38rem; right: -8rem; top: -6rem; background: radial-gradient(circle, rgba(0, 160, 170, 0.45), transparent 65%); }
  .g2 { width: 30rem; height: 30rem; left: -10rem; bottom: -12rem; background: radial-gradient(circle, rgba(47, 168, 102, 0.28), transparent 65%); }
  .lineart { width: min(56rem, 90vw); right: -12rem; top: 50%; transform: translateY(-48%) rotate(-8deg); opacity: 0.22; }
  .lineart path { fill: none; stroke: #4fd1c5; stroke-width: 0.35; stroke-dasharray: 1; stroke-dashoffset: 0; }

  .hero-grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 2rem; align-items: center; padding-block: clamp(2rem, 1.5rem + 2vw, 3.5rem) 1.5rem; }
  .hero-copy { display: grid; gap: 1.6rem; justify-items: start; }
  .kicker {
    display: inline-flex; align-items: center; gap: 0.6rem; font-size: var(--step--1); font-weight: 650; color: #cfe7e4;
    padding: 0.45rem 0.9rem 0.45rem 0.75rem; border-radius: 999px; background: rgba(255, 255, 255, 0.05);
    box-shadow: inset 0 0 0 1px rgba(143, 203, 198, 0.22); backdrop-filter: blur(6px);
  }
  .pulse { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 0 rgba(47, 168, 102, 0.6); animation: pulse 2s infinite; }
  h1 { color: var(--white); font-size: clamp(3rem, 1.6rem + 4.8vw, 6rem); font-weight: 800; font-stretch: 68%; line-height: 0.92; letter-spacing: -0.02em; }
  .line { display: block; overflow: hidden; padding-bottom: 0.05em; }
  .line > span { display: block; }
  .sheen {
    background: linear-gradient(100deg, #ffffff 40%, #7fe3d9 50%, #ffffff 60%); background-size: 250% 100%; background-position: 100% 0;
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hero-lede { font-size: var(--step-1); line-height: 1.5; max-width: 30em; color: #b7d3d1; }
  .hero :global(.btn-ghost) { background: rgba(255, 255, 255, 0.06); color: var(--white); box-shadow: inset 0 0 0 1.5px rgba(183, 211, 209, 0.45); backdrop-filter: blur(6px); }
  .hero :global(.btn-ghost:hover) { background: rgba(255, 255, 255, 0.12); }
  .hero :global(.btn-main) { box-shadow: 0 10px 40px -10px rgba(245, 184, 46, 0.55); }

  .stage { position: relative; }
  .pond { width: 100%; height: auto; overflow: visible; }
  .ground line { stroke: rgba(143, 203, 198, 0.1); stroke-width: 1; }
  .wall { fill: url(#h-wall); }
  .wall.w2 { fill: #0a3c44; }
  .floor { fill: #062a31; }
  .folds line { stroke: rgba(143, 203, 198, 0.12); stroke-width: 1; }
  .water { fill: url(#h-water); }
  .rim { fill: none; stroke: #5fe0d4; stroke-width: 2; stroke-linejoin: round; }
  .glowline { stroke-width: 5; opacity: 0.55; }
  .edge { fill: none; stroke: rgba(95, 224, 212, 0.7); stroke-width: 1.4; }
  .dims line { stroke: rgba(207, 231, 228, 0.55); stroke-width: 1; stroke-dasharray: 3 4; }
  .dims text { fill: #cfe7e4; font: 650 13px var(--font); }
  :global([data-pond-ripples]) ellipse, :global([data-pond-ripples]) circle { fill: none; stroke: #bff4ee; vector-effect: non-scaling-stroke; }

  .chip {
    position: absolute; display: inline-flex; align-items: center; gap: 0.55rem; white-space: nowrap;
    font-size: var(--step--1); font-weight: 650; color: #e6f4f2; padding: 0.55rem 0.95rem 0.55rem 0.8rem; border-radius: 999px;
    background: rgba(4, 30, 35, 0.72); box-shadow: inset 0 0 0 1px rgba(143, 203, 198, 0.25), 0 12px 30px -12px rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
  }
  .chip strong { color: var(--gold); font-weight: 800; }
  .chip .dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: #4fd1c5; box-shadow: 0 0 10px #4fd1c5; }
  .c1 { left: 2%; top: 4%; } .c2 { right: 0; top: 30%; } .c3 { left: 6%; bottom: 14%; } .c4 { right: 6%; bottom: 2%; }

  .edge-wave { display: block; width: 100%; height: clamp(2.5rem, 5vw, 5rem); margin-top: 0.5rem; }
  .edge-wave path { fill: var(--mist); }
  .edge-wave .edge-line { fill: none; stroke: #2fa866; stroke-width: 2; vector-effect: non-scaling-stroke; }
  .facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid rgba(143, 203, 198, 0.16); }
  .facts > div { display: grid; gap: 0.25rem; padding: 1.4rem 1.25rem 1.6rem 0; }
  .facts > div + div { padding-left: 1.5rem; border-left: 1px solid rgba(143, 203, 198, 0.16); }
  .facts strong { font-size: clamp(2rem, 1.5rem + 1.8vw, 3rem); font-weight: 800; font-stretch: 75%; line-height: 1; color: #5fe0d4; }
  .facts span { font-size: var(--step--1); color: #9fc2bf; line-height: 1.4; }
  .facts :global([data-price]) { color: var(--white); font-weight: 700; }

  @keyframes pulse { 70% { box-shadow: 0 0 0 0.6rem rgba(47, 168, 102, 0); } 100% { box-shadow: 0 0 0 0 rgba(47, 168, 102, 0); } }

  /* Entrance, once the intro has finished (or straight away when there is none). */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js:not(.intro-done)) .hero .line > span,
    :global(html.js:not(.intro-done)) .hero .kicker,
    :global(html.js:not(.intro-done)) .hero .hero-lede,
    :global(html.js:not(.intro-done)) .hero .btn-row,
    :global(html.js:not(.intro-done)) .hero .chip,
    :global(html.js:not(.intro-done)) .hero .facts > div { opacity: 0; }
    :global(html.intro-done) .hero .line > span { animation: up 900ms var(--ease-out) both; }
    :global(html.intro-done) .hero .line:nth-child(2) > span { animation-delay: 70ms; }
    :global(html.intro-done) .hero .line:nth-child(3) > span { animation-delay: 140ms; }
    :global(html.intro-done) .hero .line:nth-child(4) > span { animation-delay: 210ms; }
    :global(html.intro-done) .hero .sheen { animation: up 900ms var(--ease-out) 210ms both, sheen 2.2s ease-in-out 1.1s both; }
    :global(html.intro-done) .hero .kicker { animation: fadeUp 700ms var(--ease-out) both; }
    :global(html.intro-done) .hero .hero-lede { animation: fadeUp 800ms var(--ease-out) 350ms both; }
    :global(html.intro-done) .hero .btn-row { animation: fadeUp 800ms var(--ease-out) 450ms both; }
    :global(html.intro-done) .hero .draw { stroke-dasharray: 1; stroke-dashoffset: 1; animation: drawline 1400ms cubic-bezier(0.65, 0, 0.35, 1) 200ms forwards; }
    :global(html.intro-done) .hero .glowline { animation: fadeIn 900ms ease-out 1100ms both; }
    :global(html.intro-done) .hero .water { animation: fadeIn 1000ms ease-out 900ms both; }
    :global(html.intro-done) .hero .wall, :global(html.intro-done) .hero .floor, :global(html.intro-done) .hero .folds { animation: fadeIn 900ms ease-out 400ms both; }
    :global(html.intro-done) .hero .dims { animation: fadeIn 700ms ease-out 1300ms both; }
    :global(html.intro-done) .hero .lineart path { stroke-dashoffset: 1; animation: drawline 2.4s cubic-bezier(0.65, 0, 0.35, 1) 300ms forwards; }
    :global(html.intro-done) .hero .chip { animation: chipIn 700ms var(--ease-out) both, float 6s ease-in-out 1.6s infinite; }
    :global(html.intro-done) .hero .c1 { animation-delay: 1000ms, 1.7s; }
    :global(html.intro-done) .hero .c2 { animation-delay: 1150ms, 2.4s; }
    :global(html.intro-done) .hero .c3 { animation-delay: 1300ms, 2s; }
    :global(html.intro-done) .hero .c4 { animation-delay: 1450ms, 2.8s; }
    :global(html.intro-done) .hero .facts > div { animation: fadeUp 700ms var(--ease-out) both; }
    :global(html.intro-done) .hero .facts > div:nth-child(1) { animation-delay: 600ms; }
    :global(html.intro-done) .hero .facts > div:nth-child(2) { animation-delay: 680ms; }
    :global(html.intro-done) .hero .facts > div:nth-child(3) { animation-delay: 760ms; }
    :global(html.intro-done) .hero .facts > div:nth-child(4) { animation-delay: 840ms; }
    :global(html.intro-done) .hero .g1 { animation: drift 18s ease-in-out infinite alternate; }
    :global(html.intro-done) .hero .g2 { animation: drift 22s ease-in-out infinite alternate-reverse; }
  }
  @keyframes up { from { transform: translateY(105%); } to { transform: none; } }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes drawline { to { stroke-dashoffset: 0; } }
  @keyframes chipIn { from { opacity: 0; transform: translateY(10px) scale(0.96); } to { opacity: 1; transform: none; } }
  @keyframes float { 0%, 100% { translate: 0 0; } 50% { translate: 0 -7px; } }
  @keyframes sheen { from { background-position: 100% 0; } to { background-position: 0% 0; } }
  @keyframes drift { from { transform: translate(0, 0); } to { transform: translate(-3rem, 2rem); } }

  @media (max-width: 960px) {
    .hero-grid { grid-template-columns: 1fr; padding-top: 2rem; }
    .stage { max-width: 34rem; width: 100%; justify-self: center; margin-top: 0.5rem; }
    .lineart { right: -22rem; opacity: 0.16; }
    .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .facts > div:nth-child(3) { padding-left: 0; border-left: 0; }
    .facts > div:nth-child(n + 3) { border-top: 1px solid rgba(143, 203, 198, 0.16); }
  }
  @media (max-width: 520px) {
    .chip { font-size: 0.78rem; padding: 0.4rem 0.7rem 0.4rem 0.6rem; }
    .c2, .c4 { display: none; }
    .c1 { left: 0; top: 0; } .c3 { left: auto; right: 0; bottom: 6%; }
  }
</style>

<script>
  import { currentFeed } from '../scripts/live-prices';
  // Rain-like ripples on the background, and expanding rings on the pond's water.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-ripples]');
  const pondG = document.querySelector<SVGGElement>('[data-pond-ripples]');
  currentFeed();

  type Ring = { x: number; y: number; r: number; max: number; born: number; life: number };
  let rings: Ring[] = [];
  let pondRings: { el: SVGCircleElement; born: number; cx: number; cy: number }[] = [];
  let visible = true;
  let last = 0;
  let lastPond = 0;

  function size() {
    if (!canvas || !hero) return;
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    canvas.width = hero.clientWidth * dpr;
    canvas.height = hero.clientHeight * dpr;
    canvas.getContext('2d')?.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function frame(t: number) {
    if (!canvas || !hero) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const w = hero.clientWidth, h = hero.clientHeight;
    ctx.clearRect(0, 0, w, h);
    if (t - last > 520 && rings.length < 14) {
      last = t;
      rings.push({ x: Math.random() * w, y: h * (0.15 + Math.random() * 0.85), r: 0, max: 40 + Math.random() * 110, born: t, life: 3200 + Math.random() * 1800 });
    }
    rings = rings.filter((g) => t - g.born < g.life);
    for (const g of rings) {
      const k = (t - g.born) / g.life;
      const r = g.max * (1 - Math.pow(1 - k, 3));
      for (let i = 0; i < 3; i++) {
        const rr = r - i * 9;
        if (rr <= 0) continue;
        ctx.beginPath();
        ctx.ellipse(g.x, g.y, rr, rr * 0.36, 0, 0, Math.PI * 2);
        ctx.strokeStyle = `rgba(95, 224, 212, ${(0.32 - i * 0.09) * (1 - k)})`;
        ctx.lineWidth = 1;
        ctx.stroke();
      }
    }
    if (pondG) {
      if (t - lastPond > 900) {
        lastPond = t;
        const el = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        const cx = 3 + Math.random() * 14, cy = 3 + Math.random() * 14;
        el.setAttribute('cx', String(cx)); el.setAttribute('cy', String(cy));
        el.setAttribute('fill', 'none'); el.setAttribute('stroke', '#bff4ee'); el.setAttribute('vector-effect', 'non-scaling-stroke');
        pondG.appendChild(el);
        pondRings.push({ el, born: t, cx, cy });
      }
      pondRings = pondRings.filter((p) => {
        const k = (t - p.born) / 3600;
        if (k >= 1) { p.el.remove(); return false; }
        p.el.setAttribute('r', (0.2 + 7 * (1 - Math.pow(1 - k, 2))).toFixed(2));
        p.el.setAttribute('stroke-opacity', (0.75 * (1 - k)).toFixed(2));
        p.el.setAttribute('stroke-width', '1');
        return true;
      });
    }
    if (visible && !document.hidden) requestAnimationFrame(frame);
  }

  function countUp() {
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const to = Number(el.dataset.count);
      if (reduce || !to) return;
      const t0 = performance.now();
      const step = (t: number) => {
        const k = Math.min(1, (t - t0) / 1100);
        el.textContent = String(Math.round(to * (1 - Math.pow(1 - k, 3))));
        if (k < 1) requestAnimationFrame(step);
      };
      el.textContent = '0';
      requestAnimationFrame(step);
    });
  }

  if (!reduce && canvas && hero) {
    size();
    addEventListener('resize', size);
    new IntersectionObserver(([e]) => {
      const was = visible;
      visible = e.isIntersecting;
      if (visible && !was) requestAnimationFrame(frame);
    }).observe(hero);
    document.addEventListener('visibilitychange', () => { if (!document.hidden && visible) requestAnimationFrame(frame); });
    const go = () => { requestAnimationFrame(frame); setTimeout(countUp, 600); };
    if (document.documentElement.classList.contains('intro-done')) go();
    else addEventListener('fishtech:intro-done', go, { once: true });
  }
</script>
