---
import Price from './Price.astro';
import WaButton from './WaButton.astro';
import { PHONE } from '../lib/site';
---
<section class="section deep assistant" id="assistant" aria-labelledby="assistant-title">
  <div class="wrap a-grid">
    <div class="stack a-text">
      <h2 id="assistant-title">Our assistant answers on WhatsApp, day and night</h2>
      <p class="lede">It's an automated assistant that knows our prices, pond sizes and delivery charges. Tell it what you need and where your farm is, and it replies with a written quotation, as a message and a PDF.</p>
      <ul class="facts" role="list">
        <li>Answers any time, weekends included</li>
        <li>Quotes ponds, nets, fingerlings, feed and delivery</li>
        <li>Our team checks larger jobs and follows up in person to arrange your site visit</li>
      </ul>
      <div class="btn-row">
        <WaButton tag="assistant" message="Hi FishTech, I'd like a quotation." label="Start a chat" />
        <span class="num phone">{PHONE}</span>
      </div>
    </div>
    <figure class="phone-mock" data-reveal aria-label="Example conversation with the FishTech assistant">
      <div class="screen">
        <div class="bar"><img src="/brand/fishtech-profile.svg" alt="" width="36" height="36" /><div><strong>FishTech</strong><span>Example conversation</span></div></div>
        <div class="chat">
          <p data-msg class="msg me">Hi, how much is a 10 by 10 pond with 300 micron liner? I'm near Bindura.</p>
          <p data-msg class="msg them">Hi, thanks for contacting FishTech. A 10 × 10 m pond, 1.5 m deep, with 300 micron liner is <Price k="pond:10 x 10 m:300" />. Delivery and logistics to Bindura is <Price k="band:1" /> for the whole order.</p>
          <p data-msg class="msg them">I'm sending your quotation as a PDF now. Would you like fingerlings and feed included?</p>
          <p data-msg class="msg me">Yes please, fingerlings too.</p>
        </div>
      </div>
      <figcaption class="muted">An example of how a conversation goes. Prices are today's.</figcaption>
    </figure>
  </div>
</section>
<style>
  .a-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(2rem, 1rem + 4vw, 6rem); align-items: center; }
  .a-text { gap: 1.5rem; }
  .assistant h2 { font-size: var(--step-5); }
  .assistant .lede { color: var(--on-deep-muted); }
  .facts { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .facts li { padding-left: 1.6rem; position: relative; }
  .facts li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 0.7rem; height: 0.7rem; border-radius: 3px; background: var(--green); }
  .phone { font-weight: 700; color: var(--white); font-size: var(--step-1); }
  .phone-mock { justify-self: center; width: min(100%, 22rem); display: grid; gap: 0.75rem; }
  .screen { background: #e7efed; border-radius: 28px; border: 8px solid #0f2a30; overflow: hidden; color: var(--ink); box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.6); }
  .bar { display: flex; gap: 0.6rem; align-items: center; background: var(--teal); color: var(--white); padding: 0.75rem 0.9rem; }
  .bar img { border-radius: 50%; }
  .bar strong { display: block; line-height: 1.2; }
  .bar span { font-size: 0.75rem; opacity: 0.85; }
  .chat { display: grid; gap: 0.55rem; padding: 1rem 0.8rem 1.25rem; font-size: 0.9rem; line-height: 1.45; }
  .msg { max-width: 85%; padding: 0.55rem 0.75rem; border-radius: 12px; }
  .me { justify-self: end; background: #d4f1dd; border-bottom-right-radius: 4px; }
  .them { justify-self: start; background: var(--white); border-bottom-left-radius: 4px; }
  .them :global([data-price]) { font-weight: 750; color: var(--teal); }
  .phone-mock figcaption { text-align: center; }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .phone-mock .msg { opacity: 0; transform: translateY(10px) scale(0.97); transition: opacity 500ms var(--ease-out), transform 500ms var(--ease-out); }
    :global(html.js) .phone-mock.in .msg { opacity: 1; transform: none; }
    :global(html.js) .phone-mock.in .msg:nth-child(2) { transition-delay: 700ms; }
    :global(html.js) .phone-mock.in .msg:nth-child(3) { transition-delay: 1500ms; }
    :global(html.js) .phone-mock.in .msg:nth-child(4) { transition-delay: 2300ms; }
  }
  @media (max-width: 860px) { .a-grid { grid-template-columns: 1fr; } }
</style>
