---
import { PHONE, CHANNEL, wa, HELLO } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="grid">
      <div class="stack">
        <img src="/brand/fishtech-logo-white.svg" alt="FishTech, Aquaculture Services" width="383" height="90" style="height:3.2rem;width:auto" />
        <p>Fish ponds, bird and predator nets, tilapia fingerlings and feed, across Zimbabwe. Based near Harare.</p>
      </div>
      <div>
        <h3>Get a price</h3>
        <ul>
          <li><a href={wa(HELLO, 'footer')} data-wa-tag="footer">WhatsApp {PHONE}</a></li>
          <li>Open 24/7 on WhatsApp</li>
          <li><a href={CHANNEL} rel="noopener">Follow our WhatsApp channel</a></li>
        </ul>
      </div>
      <div>
        <h3>Prices and guides</h3>
        <ul>
          <li><a href="/pond-prices">Pond prices</a></li>
          <li><a href="/start-fish-farming-zimbabwe">Start fish farming</a></li>
          <li><a href="/areas-we-cover">Areas we cover</a></li>
        </ul>
      </div>
      <div>
        <h3>FishTech</h3>
        <ul>
          <li><a href="/#our-work">Our work</a></li>
          <li><a href="/#questions">Common questions</a></li>
          <li><a href="/privacy">Privacy</a></li>
        </ul>
      </div>
    </div>
    <div class="base">
      <span class="left">© {year} FishTech <span class="credit">Built by <b>Daniel Anesu Chadambuka</b></span></span>
      <span>Prices in US dollars, from our published price list.</span>
    </div>
  </div>
</footer>

<style>
  .left { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 1rem; }
  .credit { display: inline-flex; align-items: center; gap: 0.45rem; letter-spacing: 0.01em; }
  .credit::before { content: ''; width: 1.1rem; height: 1px; background: linear-gradient(90deg, transparent, var(--glow)); }
  .credit b { font-weight: 650; color: #ffffff; background: linear-gradient(90deg, #ffffff, var(--glow)) left bottom / 0 1px no-repeat; transition: background-size 0.5s ease; padding-bottom: 1px; }
  .credit:hover b { background-size: 100% 1px; }
</style>
