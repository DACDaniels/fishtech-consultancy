---
import TownPicker from './TownPicker.astro';
// Pond price calculator with a to-scale plan drawing. Server renders the
// starting state (10 × 10 m, thinnest liner) so the section is complete before
// any script runs; src/scripts/calculator.ts makes it live.
import Price from './Price.astro';
import Icon from './Icon.astro';
import { feed, plan, wa } from '../lib/site';
import { microns, pondSizes, quote, quoteMessage, stockingPlan, usd, type QuoteInput } from '../lib/pricing';

interface Props { tag?: string; headingLevel?: 'h2' | 'h3'; id?: string }
const { tag = 'calculator', headingLevel = 'h2', id = 'prices' } = Astro.props;
const H = headingLevel;
const sizes = pondSizes(feed);
const ms = microns(feed);
const start: QuoteInput = { size: sizes[0].key, micron: ms[0], net: false, fingerlings: false, feed: false };
const q = quote(feed, plan, start);
const sp = stockingPlan(feed, plan, sizes[0].area);
const PX = 12; // pixels per metre in the drawing
const CX = 228, CY = 186;
const W0 = sizes[0].length * PX, H0 = sizes[0].width * PX;
---
<section class="section calc" id={id} aria-labelledby={`${id}-title`} data-calc data-tag={tag} data-plan={JSON.stringify(plan)}>
  <div class="wrap">
    <div class="section-head">
      <H data-motion="lines" id={`${id}-title`}>Price your pond</H>
      <p class="lede" data-motion="fade">Choose a size and liner, add what you need, and tell us where your farm is. You'll see the price straight away. Send it to us on WhatsApp for a written quotation.</p>
    </div>

    <div class="calc-grid">
      <div class="left">
      <div class="drawing">
        <svg viewBox="0 0 440 330" role="img" aria-labelledby={`${id}-drawing`} data-drawing>
          <title id={`${id}-drawing`}>Plan drawing of the pond you have chosen, to scale</title>
          <defs>
            <pattern id={`${id}-net`} width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
              <path d="M0 0v10M0 0h10" stroke="#ffffff" stroke-opacity=".55" stroke-width="1" />
            </pattern>
            <linearGradient id={`${id}-water`} x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#2fd0c6" stop-opacity=".55" /><stop offset="1" stop-color="#00707c" stop-opacity=".55" />
            </linearGradient>
          </defs>
          <rect x="0" y="0" width="440" height="330" rx="14" class="ground" />
          <g class="grid-lines" aria-hidden="true">
            {Array.from({ length: 10 }, (_, i) => <line x1={(i + 1) * 40} y1="0" x2={(i + 1) * 40} y2="330" />)}
            {Array.from({ length: 7 }, (_, i) => <line x1="0" y1={(i + 1) * 45} x2="440" y2={(i + 1) * 45} />)}
          </g>
          <rect data-pond x={CX - W0 / 2} y={CY - H0 / 2} width={W0} height={H0} rx="3" fill={`url(#${id}-water)`} class="pond" stroke-width="3" />
          <rect data-net x={CX - W0 / 2} y={CY - H0 / 2} width={W0} height={H0} rx="3" fill={`url(#${id}-net)`} hidden />
          <g class="dim" aria-hidden="true">
            <line data-dim-top x1={CX - W0 / 2} y1={CY - H0 / 2 - 22} x2={CX + W0 / 2} y2={CY - H0 / 2 - 22} />
            <line data-tick-tl x1={CX - W0 / 2} x2={CX - W0 / 2} y1={CY - H0 / 2 - 30} y2={CY - H0 / 2 - 14} />
            <line data-tick-tr x1={CX + W0 / 2} x2={CX + W0 / 2} y1={CY - H0 / 2 - 30} y2={CY - H0 / 2 - 14} />
            <text data-label-len x={CX} y={CY - H0 / 2 - 30} text-anchor="middle">{sizes[0].length} m</text>
            <line data-dim-left x1={CX - W0 / 2 - 22} y1={CY - H0 / 2} x2={CX - W0 / 2 - 22} y2={CY + H0 / 2} />
            <line data-tick-lt y1={CY - H0 / 2} y2={CY - H0 / 2} x1={CX - W0 / 2 - 30} x2={CX - W0 / 2 - 14} />
            <line data-tick-lb y1={CY + H0 / 2} y2={CY + H0 / 2} x1={CX - W0 / 2 - 30} x2={CX - W0 / 2 - 14} />
            <text data-label-wid x={CX - W0 / 2 - 34} y={CY + 4} text-anchor="end">{sizes[0].width} m</text>
          </g>
          <text data-fish x={CX} y={CY + 5} text-anchor="middle" class="fish" hidden>{sp.fingerlings.toLocaleString('en-US')} fish</text>
        </svg>
        <p class="small muted">Drawn to scale. Every pond is 1.5 m deep. Thicker liner is drawn with a heavier edge.</p>
      </div>

      <div class="result" aria-live="polite">
          <ul class="lines" data-lines>
            {q.lines.map((l) => <li><span>{l.label}</span><span class="num">{usd(l.amount)}</span></li>)}
          </ul>
          <div class="total">
            <span>Total</span>
            <strong class="num" data-total>{usd(q.total)}</strong>
          </div>
          <p class="small" data-note>Add your town to include delivery and logistics.</p>
          <a class="btn btn-main" data-send href={wa(quoteMessage(feed, start, q), tag)} data-wa-tag={tag}>
            <Icon name="chat" /><span>Send this to us on WhatsApp</span>
          </a>
          <p class="small fine">A guide from our published price list. We send your written quotation, which holds for 30 days. A site visit costs <Price k="site-visit" />, taken off the job if you go ahead.</p>
        </div>
      </div>
      <form class="calc-form" data-form>
        <fieldset>
          <legend>Pond size</legend>
          <div class="chips">
            {sizes.map((s, i) => (
              <label class="chip"><input type="radio" name="size" value={s.key} checked={i === 0} /><span>{s.label}</span></label>
            ))}
          </div>
          <p class="small muted">Other sizes on request.</p>
        </fieldset>
        <fieldset>
          <legend>Liner thickness</legend>
          <div class="chips">
            {ms.map((m, i) => (
              <label class="chip"><input type="radio" name="micron" value={m} checked={i === 0} /><span>{m} micron</span></label>
            ))}
          </div>
          <p class="small muted">Thicker liner is stronger and lasts longer.</p>
        </fieldset>
        <fieldset>
          <legend>Add to your order</legend>
          <label class="tick"><input type="checkbox" name="net" /><span>Bird / predator net</span><Icon name="check" /></label>
          <label class="tick"><input type="checkbox" name="fingerlings" /><span>Tilapia fingerlings for this pond</span><Icon name="check" /></label>
          <label class="tick"><input type="checkbox" name="feed" /><span>Feed from start to harvest</span><Icon name="check" /></label>
        </fieldset>
        <div class="field">
          <TownPicker id={`${id}-town`} name="town" label="Where is your farm?" hint="Nearest town" placeholder="Search, or type your town" />
          <p class="small muted" data-town-help aria-live="polite">Delivery and logistics is one charge per order, from <Price k="band:0" />, by road distance from Harare.</p>
        </div>
      </form>

    </div>
  </div>
</section>

<script>
  import '../scripts/calculator';
</script>

<style>
  .calc { background: var(--white); }
  .calc-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(1.5rem, 1rem + 3vw, 4rem); align-items: start; }
  .left { display: grid; gap: 1.5rem; position: sticky; top: calc(var(--header-h) + 1rem); }
  .drawing { display: grid; gap: 0.75rem; }
  .drawing svg { width: 100%; height: auto; }
  .drawing svg { border-radius: var(--radius); box-shadow: 0 30px 60px -30px rgba(6, 58, 67, 0.55); }
  .ground { fill: #05303a; }
  .grid-lines line { stroke: rgba(143, 203, 198, 0.12); stroke-width: 1; }
  .pond { stroke: #5fe0d4; stroke-linejoin: round; filter: drop-shadow(0 0 6px rgba(95, 224, 212, 0.55)); }
  .dim line { stroke: rgba(207, 231, 228, 0.7); stroke-width: 1.2; }
  .dim text { fill: #e6f4f2; font: 700 15px var(--font); font-stretch: 88%; }
  .fish { fill: #ffffff; font: 700 14px var(--font); }

  fieldset { border: 0; padding: 0; margin: 0 0 1.5rem; display: grid; gap: 0.6rem; min-width: 0; }
  legend, .field label { font-weight: 750; color: var(--deep); margin-bottom: 0.6rem; padding: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip { position: relative; }
  .chip input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .chip span {
    display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0.5rem 0.95rem; border-radius: 10px;
    border: 1.5px solid var(--line); background: var(--mist); font-weight: 650; font-variant-numeric: tabular-nums;
    transition: background-color 150ms, border-color 150ms, color 150ms;
  }
  .chip input:checked + span { background: var(--teal); border-color: var(--teal); color: var(--white); }
  .chip input:focus-visible + span { outline: 3px solid var(--gold); outline-offset: 2px; }
  .tick {
    display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 0.75rem; cursor: pointer;
    padding: 0.75rem 0.9rem; border-radius: 10px; border: 1.5px solid var(--line); background: var(--mist); font-weight: 600; position: relative;
  }
  .tick input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .tick :global(svg) { width: 1.4rem; height: 1.4rem; padding: 0.15rem; border-radius: 6px; border: 1.5px solid var(--line); color: transparent; background: var(--white); }
  .tick:has(input:checked) { border-color: var(--teal); background: var(--tint); }
  .tick:has(input:checked) :global(svg) { background: var(--teal); border-color: var(--teal); color: var(--white); }
  .tick:has(input:focus-visible) { outline: 3px solid var(--gold); outline-offset: 2px; }
  .field { display: grid; gap: 0.25rem; }
  .field input {
    font: inherit; padding: 0.8rem 0.9rem; border-radius: 10px; border: 1.5px solid var(--line); background: var(--white); color: var(--ink); min-height: 3rem;
  }
  .field input:focus { border-color: var(--teal); outline: none; box-shadow: 0 0 0 3px var(--tint); }
  .field .muted { font-weight: 500; }

  .result { background: var(--deep); color: var(--white); border-radius: var(--radius); padding: clamp(1.25rem, 1rem + 1vw, 1.75rem); display: grid; gap: 1rem; }
  .lines { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; font-size: var(--step--1); }
  .lines :global(li) { display: flex; justify-content: space-between; gap: 1rem; color: var(--on-deep-muted); }
  .lines :global(li span:last-child) { color: var(--white); font-weight: 650; white-space: nowrap; }
  .total { display: flex; justify-content: space-between; align-items: baseline; border-top: 1px solid var(--deep-2); padding-top: 1rem; }
  .total span { font-weight: 700; }
  .total strong { color: var(--gold); font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem); font-weight: 800; font-stretch: 78%; line-height: 1; }
  .result [data-note] { color: var(--on-deep-muted); }
  .fine { color: var(--on-deep-muted); }
  .fine :global([data-price]) { color: var(--white); }

  @media (max-width: 860px) {
    .calc-grid { grid-template-columns: 1fr; }
    .left { display: contents; }
    .drawing { order: 1; max-width: 34rem; }
    .calc-form { order: 2; }
    .result { order: 3; }
  }
</style>
