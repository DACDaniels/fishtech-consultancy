---
import type { QA } from '../lib/faq';
interface Props { items: QA[]; title?: string; id?: string }
const { items, title = 'Common questions', id = 'questions' } = Astro.props;
---
<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <div class="section-head"><h2 id={`${id}-title`}>{title}</h2></div>
    <div class="faq">
      {items.map((i) => (
        <details>
          <summary>{i.q}</summary>
          <div class="answer">{i.a.map((p) => <p>{p}</p>)}</div>
        </details>
      ))}
    </div>
  </div>
</section>
