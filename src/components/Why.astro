---
import { Picture } from 'astro:assets';
import sunrise from '../assets/photos/pond-new-sunrise.jpg';
const standards = [
  ['Published prices', 'Our pond, net, fingerling, feed and delivery prices are all on this website, and our assistant quotes from the same list.'],
  ['One delivery charge', 'Delivery and logistics is charged once per order, however many trips the job takes.'],
  ['Ground checked first', 'We look at your ground and water before we build.'],
  ['No chemicals', "We don't include chemicals in our packages, and we advise farmers not to use them in ponds."],
  ['Straight answers', "We don't promise harvest weights, growth or survival. They depend on water, feeding and care, and we'll help you plan for them."],
];
---
<figure class="band">
  <Picture src={sunrise} formats={['avif', 'webp']} widths={[800, 1400, 2200]} sizes="100vw" alt="A newly lined pond with a little water in it at sunrise" loading="lazy" />
</figure>
<section class="section why" id="why" aria-labelledby="why-title">
  <div class="wrap why-grid">
    <div class="stack">
      <h2 id="why-title">Why FishTech</h2>
      <p class="lede">Fish farming in Zimbabwe is still mostly done by hand, and feeding is often guesswork. FishTech is a Zimbabwean aquaculture and technology company working to make fish farming more efficient and profitable through digital tools, starting with the basics done properly.</p>
      <p class="muted small">Our work is aligned with Vision 2030 and the National Development Strategy 2 on food security and innovation, and with the Sustainable Development Goals on zero hunger, decent work, industry and innovation, responsible production, and life below water.</p>
    </div>
    <dl class="standards">
      {standards.map(([t, d]) => (<div><dt>{t}</dt><dd>{d}</dd></div>))}
    </dl>
  </div>
</section>
<style>
  .band { height: clamp(16rem, 40vw, 34rem); overflow: hidden; }
  .band :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; }
  .why-grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: clamp(2rem, 1rem + 4vw, 6rem); }
  .why .stack { gap: 1.5rem; align-content: start; }
  .standards { margin: 0; display: grid; border-top: 2px solid var(--deep); }
  .standards div { padding-block: 1.1rem; border-bottom: 1px solid var(--line); display: grid; gap: 0.3rem; }
  dt { font-weight: 800; font-size: var(--step-1); color: var(--deep); }
  dd { margin: 0; color: var(--muted); }
  @media (max-width: 860px) { .why-grid { grid-template-columns: 1fr; } }
</style>
