---
// Opening animation, first visit of a session only (about 2.6 s, skipped for reduced motion).
// 1. The FishTech mark draws itself: outline, water filling, land rising, name.
// 2. The mark lets go of a single drop of water.
// 3. The drop lands; ripples spread and open a widening hole that reveals the site.
// The inline script in Base.astro adds `intro` to <html> before first paint.
---
<div class="intro" aria-hidden="true" data-intro>
  <div class="sheet" data-sheet></div>
  <div class="center" data-center>
    <svg class="mark" viewBox="-4 -4 108 108">
      <defs>
        <clipPath id="intro-water"><rect data-water-rise x="-4" y="-4" width="108" height="108" /></clipPath>
        <clipPath id="intro-land"><rect data-land-rise x="-4" y="-4" width="108" height="108" /></clipPath>
      </defs>
      <path class="trace" data-trace d="M 26,0 L 100,0 L 100,44 C 86,48 68,44 56,52 C 38,64 22,42 0,54 L 0,26 A 26 26 0 0 1 26,0 Z" />
      <path class="trace" data-trace d="M 0,60 C 22,48 38,70 56,58 C 68,50 86,54 100,50 L 100,74 A 26 26 0 0 1 74,100 L 0,100 Z" />
      <g clip-path="url(#intro-water)"><path class="water" d="M 26,0 L 100,0 L 100,44 C 86,48 68,44 56,52 C 38,64 22,42 0,54 L 0,26 A 26 26 0 0 1 26,0 Z" /></g>
      <g clip-path="url(#intro-land)"><path class="land" d="M 0,60 C 22,48 38,70 56,58 C 68,50 86,54 100,50 L 100,74 A 26 26 0 0 1 74,100 L 0,100 Z" /></g>
    </svg>
    <div class="name"><span data-name>FishTech</span></div>
  </div>
  <span class="drop" data-drop></span>
  <span class="ring" data-ring></span><span class="ring" data-ring></span><span class="ring" data-ring></span>
</div>

<style>
  .intro { display: none; }
  :global(html.intro) .intro { display: block; position: fixed; inset: 0; z-index: 1000; pointer-events: none; --r: 0px; }
  :global(html.intro) body { overflow: hidden; }
  .sheet {
    position: absolute; inset: 0;
    background: radial-gradient(120% 90% at 50% 40%, var(--deep) 0%, var(--ink-deep) 75%);
    mask-image: radial-gradient(circle at 50% 58%, transparent var(--r), #000 calc(var(--r) + 1px));
    -webkit-mask-image: radial-gradient(circle at 50% 58%, transparent var(--r), #000 calc(var(--r) + 1px));
  }
  .center { position: absolute; inset: 0; display: grid; place-items: center; align-content: center; gap: 1.1rem; }
  .mark { width: clamp(5rem, 14vw, 7.5rem); height: auto; overflow: visible; filter: drop-shadow(0 0 28px rgba(var(--glow-rgb), 0.35)); }
  .trace { fill: none; stroke: var(--glow); stroke-width: 1.6; stroke-linejoin: round; }
  .water { fill: var(--brand); }
  .land { fill: var(--green); }
  .name { overflow: hidden; color: #ffffff; font-weight: 800; font-stretch: 80%; font-size: clamp(1.6rem, 4vw, 2.25rem); letter-spacing: -0.01em; line-height: 1.1; }
  .name span { display: block; }
  .drop { position: absolute; left: 50%; top: 50%; width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%; background: var(--glow); box-shadow: 0 0 18px var(--glow); opacity: 0; }
  .ring { position: absolute; left: 50%; top: 58%; width: 40px; height: 40px; margin: -20px 0 0 -20px; border-radius: 50%; border: 1.5px solid var(--glow); opacity: 0; }
</style>

<script>
  import { gsap } from 'gsap';
  const root = document.documentElement;
  if (root.classList.contains('intro')) {
    const q = (s: string) => document.querySelectorAll(s);
    const center = document.querySelector<HTMLElement>('[data-center]')!;
    const mark = center.querySelector<SVGElement>('.mark')!;
    const intro = document.querySelector<HTMLElement>('[data-intro]')!;
    q('[data-trace]').forEach((p) => p.setAttribute('pathLength', '1'));
    gsap.set('[data-trace]', { strokeDasharray: 1, strokeDashoffset: 1 });
    gsap.set(['[data-water-rise]', '[data-land-rise]'], { yPercent: 100 });
    gsap.set('[data-name]', { yPercent: 110 });
    let signalled = false;
    const signal = () => { if (!signalled) { signalled = true; root.classList.add('intro-done'); window.dispatchEvent(new Event('fishtech:intro-done')); } };
    const r = mark.getBoundingClientRect();
    const fromY = r.bottom - innerHeight / 2 - 6;
    const toY = innerHeight * 0.08;
    gsap.timeline({ onComplete: () => { root.classList.remove('intro'); signal(); } })
      .to('[data-trace]', { strokeDashoffset: 0, duration: 0.7, ease: 'power2.inOut', stagger: 0.12 })
      .to('[data-water-rise]', { yPercent: 0, duration: 0.6, ease: 'expo.out' }, 0.5)
      .to('[data-land-rise]', { yPercent: 0, duration: 0.5, ease: 'expo.out' }, 0.75)
      .to('[data-name]', { yPercent: 0, duration: 0.5, ease: 'expo.out' }, 0.85)
      // the mark lets go of a drop
      .set('[data-drop]', { opacity: 1, y: fromY, scale: 0.4 }, 1.45)
      .to(center, { opacity: 0, y: -24, duration: 0.35, ease: 'power2.in' }, 1.45)
      .to('[data-drop]', { y: toY, scale: 1, duration: 0.38, ease: 'power2.in' }, 1.47)
      // it lands: ripples spread and open the page
      .to('[data-drop]', { opacity: 0, scaleX: 2.2, scaleY: 0.3, duration: 0.12 }, 1.85)
      .fromTo('[data-ring]', { opacity: 0.9, scale: 0.2 }, { opacity: 0, scale: () => 18 + Math.random() * 10, duration: 1.3, ease: 'expo.out', stagger: 0.14 }, 1.86)
      .to(intro, { '--r': `${Math.hypot(innerWidth, innerHeight)}px`, duration: 0.95, ease: 'power3.in' }, 1.9)
      .call(signal, undefined, 2.2);
  } else {
    root.classList.add('intro-done');
  }
</script>
