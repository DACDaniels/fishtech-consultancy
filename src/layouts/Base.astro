---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Intro from '../components/Intro.astro';
import { feed, wa, HELLO, SITE, CHANNEL } from '../lib/site';

interface Props { title: string; description: string; image?: string; noFloat?: boolean; jsonLd?: Record<string, unknown>[]; headerTone?: 'light' | 'dark' }
const { title, description, image = '/og/fishtech.jpg', noFloat = false, jsonLd = [], headerTone = 'light' } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), SITE).href;
// Who the business is, for search engines. The founder is named here (and visibly in the
// footer credit) so Google links FishTech and Daniel; there is no founder section on the
// page by decision (blueacre-ops docs/DECISIONS.md 2026-10-09, "Search").
const founder = {
  '@type': 'Person',
  '@id': `${SITE}/#daniel-chadambuka`,
  name: 'Daniel Anesu Chadambuka',
  alternateName: 'Daniel Chadambuka',
  sameAs: ['https://github.com/DACDaniels'],
};
const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${SITE}/#fishtech`,
  name: 'FishTech',
  alternateName: 'FishTech Zimbabwe',
  founder,
  sameAs: [CHANNEL],
  knowsAbout: ['Fish farming', 'Tilapia farming', 'Fish pond construction', 'Pond liners', 'Tilapia fingerlings', 'Fish feed'],
  description: 'Fish pond construction with HDPE liner, bird and predator nets, tilapia fingerlings and fish feed across Zimbabwe.',
  url: SITE,
  telephone: `+${feed.whatsapp}`,
  image: `${SITE}/og/fishtech.jpg`,
  logo: `${SITE}/brand/icon-512.png`,
  address: { '@type': 'PostalAddress', addressLocality: 'Harare', addressCountry: 'ZW' },
  areaServed: { '@type': 'Country', name: 'Zimbabwe' },
  currenciesAccepted: 'USD',
};
const snapshot = JSON.stringify(feed);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          d.classList.add('motion');
          setTimeout(function () { if (!window.__motionReady) d.classList.remove('motion'); }, 4000);
        }
        try {
          var quiet = matchMedia('(prefers-reduced-motion: reduce)').matches || /bot|crawl|spider|lighthouse|headless/i.test(navigator.userAgent);
          if (!quiet && !sessionStorage.getItem('ft-intro')) {
            d.classList.add('intro');
            sessionStorage.setItem('ft-intro', '1');
            setTimeout(function () {
              if (!d.classList.contains('intro')) return;
              d.classList.remove('intro'); d.classList.add('intro-done', 'hero-ready');
              window.dispatchEvent(new Event('fishtech:intro-done'));
            }, 4500);
          }
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#04263F" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FishTech" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, SITE).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://ops.fishtech.co.zw" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify([business, ...jsonLd])} />
    <script defer src="/_vercel/insights/script.js"></script>
  </head>
  <body>
    <Intro />
    <a class="skip" href="#main">Skip to content</a>
    <Header tone={headerTone} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {!noFloat && (
      <a class="btn btn-main float-wa" href={wa(HELLO, 'float')} data-wa-tag="float" data-float data-hidden>
        <Icon name="chat" /><span>WhatsApp <span class="label-long">for a price</span></span>
      </a>
    )}
    <script type="application/json" id="feed-snapshot" set:html={snapshot} />
    <script>
      import '../scripts/live-prices';
      import '../scripts/motion';
      // Show the floating button once the first call to action has scrolled away.
      const float = document.querySelector<HTMLElement>('[data-float]');
      const first = document.querySelector('[data-first-cta]');
      if (float) {
        if (!first) float.removeAttribute('data-hidden');
        else new IntersectionObserver(([e]) => float.toggleAttribute('data-hidden', e.isIntersecting)).observe(first);
      }
    </script>
  </body>
</html>
