---
import Base from '../layouts/Base.astro';
import WaButton from '../components/WaButton.astro';
---
<Base title="Page not found | FishTech" description="This page doesn't exist. Find pond prices, our guide to fish farming, and the areas we cover.">
  <section class="section">
    <div class="wrap stack nf">
      <h1>This page isn't here</h1>
      <p class="lede">The link may be old or mistyped. These pages will get you where you were going.</p>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/pond-prices">Pond prices</a></li>
        <li><a href="/start-fish-farming-zimbabwe">How to start fish farming</a></li>
        <li><a href="/areas-we-cover">Areas we cover</a></li>
      </ul>
      <WaButton tag="404" message="Hi FishTech, I'd like a price." />
    </div>
  </section>
</Base>
<style>
  .nf { gap: 1.5rem; justify-items: start; }
  .nf h1 { font-size: var(--display); font-stretch: 72%; font-weight: 800; }
  .nf ul { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.4rem; font-size: var(--step-1); }
</style>
